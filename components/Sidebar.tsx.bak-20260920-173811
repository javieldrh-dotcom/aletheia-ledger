"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";

/**
 * Barra lateral de navegacion de la plataforma Aletheia Ledger.
 *
 * ALCANCE (2026-09-20, decision explicita del usuario): se lanza SOLO
 * con el pilar que ya esta construido y validado -- Exoplanetas, con
 * sus dos submodulos (Vetting de Transitos y Auditoria Estelar). No se
 * listan pilares futuros (Astroclimatologia, Arqueologia Galactica,
 * Mineria de Asteroides, Ondas Gravitacionales) -- ya estan diseñados
 * y validados en el sandbox (Sidebar/ComingSoonPillar + 4 paginas), pero
 * se dejan fuera de esta version para no prometerle al visitante (ni a
 * un potencial lector del libro) funcionalidad que todavia no existe.
 * Cuando el modulo de Exoplanetas + la publicacion de libros generen
 * tracción real, se reincorporan sin reescribir nada -- el diseño de
 * PILLARS abajo ya soporta ambos tipos de entrada (activa / proxima).
 *
 * Reutiliza exactamente los tokens de diseño ya establecidos en el
 * proyecto (bg-void, bg-surface, bg-surface-raised, bg-accent, text-ink,
 * text-ink-muted, border-line, font-serif, font-mono, rounded-sm) -- no
 * se introduce ninguna paleta ni libreria de iconos nueva, para no
 * romper la consistencia visual ni añadir dependencias innecesarias.
 */

interface PillarLink {
  label: string;
  href: string;
}

interface ActivePillar {
  key: string;
  label: string;
  kind: "active";
  links: PillarLink[];
}

interface ComingSoonPillar {
  key: string;
  label: string;
  kind: "comingSoon";
  href: string;
}

type Pillar = ActivePillar | ComingSoonPillar;

const PILLARS: readonly Pillar[] = [
  {
    key: "exoplanetas",
    label: "Exoplanetas",
    kind: "active",
    links: [
      { label: "Vetting de Tránsitos", href: "/" },
      { label: "Auditoría Estelar", href: "/auditoria-estelar" },
    ],
  },
];

export function Sidebar() {
  const pathname = usePathname();

  return (
    <aside className="flex h-screen w-64 shrink-0 flex-col justify-between border-r border-line bg-void p-6">
      <div>
        <div className="mb-8 flex items-center gap-2">
          <div className="h-6 w-6 rounded-tr-xl rounded-bl-xl bg-accent" />
          <h1 className="font-serif text-lg font-bold tracking-wide text-ink">
            Aletheia Ledger
          </h1>
        </div>

        <nav className="space-y-5">
          {PILLARS.map((pillar) => {
            if (pillar.kind === "active") {
              return (
                <div key={pillar.key}>
                  <p className="mb-1 px-3 font-mono text-[10px] uppercase tracking-wide text-ink-muted">
                    {pillar.label}
                  </p>
                  <div className="space-y-0.5">
                    {pillar.links.map((link) => {
                      const isActive = pathname === link.href;
                      return (
                        <Link
                          key={link.href}
                          href={link.href}
                          className={`block rounded-sm px-3 py-2 text-sm transition-colors ${
                            isActive
                              ? "border-l-2 border-accent bg-surface-raised text-accent"
                              : "text-ink-muted hover:text-ink"
                          }`}
                        >
                          {link.label}
                        </Link>
                      );
                    })}
                  </div>
                </div>
              );
            }

            const isActive = pathname === pillar.href;
            return (
              <Link
                key={pillar.key}
                href={pillar.href}
                className={`flex items-center justify-between rounded-sm px-3 py-2 text-sm transition-colors ${
                  isActive ? "bg-surface-raised text-ink" : "text-ink-muted hover:text-ink"
                }`}
              >
                <span>{pillar.label}</span>
                <span className="rounded-sm border border-line px-1.5 py-0.5 font-mono text-[9px] uppercase tracking-wide text-ink-muted">
                  Pronto
                </span>
              </Link>
            );
          })}
        </nav>
      </div>

      <p className="font-mono text-[10px] uppercase leading-relaxed tracking-wide text-ink-muted">
        Plataforma de auditoría de datos astronómicos — 100% client-side
      </p>
    </aside>
  );
}
